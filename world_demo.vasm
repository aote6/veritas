module world_demo
version 1.0.0
TRAP 0
LOAD_CONST R4, 0
ADD R1, R0, R4
CALL R1, a_body_1
TRAP 0
LOAD_CONST R4, 0
ADD R2, R0, R4
CALL R2, b_body
CALL R1, a_body_2
LOAD_CONST R4, 0
ADD R0, R1, R4
ADD R3, R2, R4
LOAD_CONST R2, 1
ADD R1, R3, R4
TRAP 2
LOAD_CONST R4, 0
ADD R1, R0, R4
ADD R2, R3, R4
TRAP 5
HALT
a_body_1:
WRITE 0, "hello from object A - first write"
RETURN
b_body:
WRITE 0, "hello from object B - first write"
RETURN
a_body_2:
WRITE 1, "hello from object A - second write, after re-entry"
RETURN
