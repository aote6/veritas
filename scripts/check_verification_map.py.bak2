#!/usr/bin/env python3
import re
import sys
from pathlib import Path

TEST_PATTERN = re.compile(
    r"^[ \t]*#\[test\]\s*"
    r"(?:\n[ \t]*///.*)*\s*"
    r"(?:async\s+)?fn\s+([A-Za-z0-9_]+)\s*\(",
    re.MULTILINE,
)

def parse_rust_tests(repo_root: Path):
    tests = {}
    tests_dir = repo_root / "tests"
    
    for file_path in sorted(tests_dir.rglob("*.rs")):
        content = file_path.read_text(encoding="utf-8")
        rel_file = file_path.relative_to(repo_root)
        
        for test_name in TEST_PATTERN.findall(content):
            test_id = f"{rel_file}::{test_name}"
            if test_id in tests:
                print(f"[FATAL] Duplicate Test ID: {test_id}")
                sys.exit(1)
            tests[test_id] = {
                "file": str(rel_file),
                "name": test_name,
            }
    
    return tests

def parse_map_markdown(map_path: Path):
    mapped = set()
    
    if not map_path.exists():
        print(f"[FATAL] Map does not exist: {map_path}")
        sys.exit(1)
    
    for line in map_path.read_text(encoding="utf-8").splitlines():
        if "|" not in line:
            continue
        
        parts = [part.strip() for part in line.split("|")]
        if len(parts) < 3:
            continue
        
        test_id = parts[1]
        if not test_id:
            continue
        if test_id == "Test ID":
            continue
        if set(test_id) <= {"-", ":"}:
            continue
        
        mapped.add(test_id)
    
    return mapped

def parse_test_metadata(content: str, test_name: str) -> dict:
    """从 doc comments 中提取测试元数据"""
    metadata = {
        'category': None,
        'layer': None,
        'testworld': None,
        'req': None,
    }
    
    pattern = re.compile(
        r'((?:[ \t]*///.*\n)+)?[ \t]*#\[test\]\s+(?:async\s+)?fn\s+' + 
        re.escape(test_name) + r'\s*\(',
        re.MULTILINE
    )
    
    match = pattern.search(content)
    if match and match.group(1):
        doc_comments = match.group(1)
        for line in doc_comments.split('\n'):
            if '@category:' in line:
                metadata['category'] = line.split('@category:')[1].strip()
            elif '@layer:' in line:
                metadata['layer'] = line.split('@layer:')[1].strip()
            elif '@testworld:' in line:
                metadata['testworld'] = line.split('@testworld:')[1].strip()
            elif '@req:' in line:
                metadata['req'] = line.split('@req:')[1].strip()
    
    return metadata

def audit_phase1(repo_root: Path):
    print("VERITAS VERIFICATION MAP AUDIT")
    print("================================")
    print("PHASE 1: TEST ID PARITY")
    print()
    
    actual = parse_rust_tests(repo_root)
    mapped = parse_map_markdown(
        repo_root / "docs" / "VERIFICATION_MAP.md"
    )
    
    actual_set = set(actual)
    mapped_set = set(mapped)
    
    missing = actual_set - mapped_set
    extra = mapped_set - actual_set
    
    print(f"[1] SOURCE TESTS : {len(actual_set)}")
    print(f"[2] MAP TESTS    : {len(mapped_set)}")
    print(f"[3] MISSING      : {len(missing)}")
    print(f"[4] EXTRA        : {len(extra)}")
    
    if missing:
        print()
        print("Missing from map:")
        for test_id in sorted(missing)[:30]:
            print(f" - {test_id}")
    
    if extra:
        print()
        print("Extra in map:")
        for test_id in sorted(extra)[:30]:
            print(f" - {test_id}")
    
    print()
    print("================================")
    
    if not missing and not extra:
        print("STATUS: PASS")
        print("Source and Map contain exactly the same Test IDs.")
        return 0
    
    print(
        f"STATUS: FAIL "
        f"(missing={len(missing)}, extra={len(extra)})"
    )
    return 1

def audit_phase2(repo_root: Path):
    """Phase 2: Metadata validation (allows untagged in pilot mode)"""
    VALID_CATEGORIES = {'A', 'B', 'C', 'D'}
    VALID_LAYERS = {'kernel', 'capability', 'transaction', 'recovery', 'integration'}
    VALID_TESTWORLD = {'FORBIDDEN', 'ALLOWED', 'PREFERRED'}
    VALID_REQUIREMENTS = {'CAP-01', 'CAP-02', 'CAP-03', 'CAP-04', 'CAP-05', 
                          'WAL-01', 'WAL-02', 'TX-01', 'REC-01', 'MACH-01'}
    
    EXPECTED_POLICIES = {
        "A": {"FORBIDDEN"},
        "B": {"FORBIDDEN"},
        "C": {"FORBIDDEN"},
        "D": {"ALLOWED", "PREFERRED"},
    }
    
    print("PHASE 2: METADATA VALIDATION (PILOT MODE)")
    print("==========================================")
    
    violations = []
    tagged_count = 0
    untagged_count = 0
    
    actual_tests = parse_rust_tests(repo_root)
    
    for test_id, test_info in actual_tests.items():
        file_path = repo_root / test_info['file']
        content = file_path.read_text(encoding='utf-8')
        metadata = parse_test_metadata(content, test_info['name'])
        
        if all(metadata.values()):
            tagged_count += 1
        else:
            untagged_count += 1
            continue
        
        if metadata['category'] not in VALID_CATEGORIES:
            violations.append(f"Invalid category '{metadata['category']}' for {test_id}")
            continue
        
        if metadata['layer'] not in VALID_LAYERS:
            violations.append(f"Invalid layer '{metadata['layer']}' for {test_id}")
        
        if metadata['testworld'] not in VALID_TESTWORLD:
            violations.append(f"Invalid testworld '{metadata['testworld']}' for {test_id}")
        
        if metadata['req'] not in VALID_REQUIREMENTS:
            violations.append(f"Invalid requirement '{metadata['req']}' for {test_id}")
        
        category = metadata['category']
        testworld = metadata['testworld']
        if category in EXPECTED_POLICIES:
            if testworld not in EXPECTED_POLICIES[category]:
                violations.append(
                    f"Category {category} requires TestWorld in {EXPECTED_POLICIES[category]}, "
                    f"got '{testworld}' for {test_id}"
                )
    
    print(f"[1] TAGGED TESTS   : {tagged_count}")
    print(f"[2] UNTAGGED TESTS : {untagged_count}")
    print(f"[3] VIOLATIONS     : {len(violations)}")
    
    if violations:
        print("\nViolations:")
        for v in violations[:20]:
            print(f"  - {v}")
        if len(violations) > 20:
            print(f"  ... and {len(violations) - 20} more")
        return 1
    
    if untagged_count > 0:
        print(f"\nSTATUS: PASS (partial) - {tagged_count}/{len(actual_tests)} tests tagged")
        print("Note: Use --phase2-strict once all tests are tagged")
    else:
        print("\nSTATUS: PASS - All tests have valid metadata")
    
    return 0

def audit_phase2_strict(repo_root: Path):
    """Phase 2 Strict: Metadata validation (requires all tests tagged)"""
    VALID_CATEGORIES = {'A', 'B', 'C', 'D'}
    VALID_LAYERS = {'kernel', 'capability', 'transaction', 'recovery', 'integration'}
    VALID_TESTWORLD = {'FORBIDDEN', 'ALLOWED', 'PREFERRED'}
    VALID_REQUIREMENTS = {'CAP-01', 'CAP-02', 'CAP-03', 'CAP-04', 'CAP-05', 
                          'WAL-01', 'WAL-02', 'TX-01', 'REC-01', 'MACH-01'}
    
    EXPECTED_POLICIES = {
        "A": {"FORBIDDEN"},
        "B": {"FORBIDDEN"},
        "C": {"FORBIDDEN"},
        "D": {"ALLOWED", "PREFERRED"},
    }
    
    print("PHASE 2 STRICT: METADATA VALIDATION")
    print("====================================")
    
    violations = []
    tagged_count = 0
    untagged_count = 0
    
    actual_tests = parse_rust_tests(repo_root)
    
    for test_id, test_info in actual_tests.items():
        file_path = repo_root / test_info['file']
        content = file_path.read_text(encoding='utf-8')
        metadata = parse_test_metadata(content, test_info['name'])
        
        if all(metadata.values()):
            tagged_count += 1
        else:
            untagged_count += 1
            violations.append(f"Missing metadata for {test_id}")
            continue
        
        if metadata['category'] not in VALID_CATEGORIES:
            violations.append(f"Invalid category '{metadata['category']}' for {test_id}")
            continue
        
        if metadata['layer'] not in VALID_LAYERS:
            violations.append(f"Invalid layer '{metadata['layer']}' for {test_id}")
        
        if metadata['testworld'] not in VALID_TESTWORLD:
            violations.append(f"Invalid testworld '{metadata['testworld']}' for {test_id}")
        
        if metadata['req'] not in VALID_REQUIREMENTS:
            violations.append(f"Invalid requirement '{metadata['req']}' for {test_id}")
        
        category = metadata['category']
        testworld = metadata['testworld']
        if category in EXPECTED_POLICIES:
            if testworld not in EXPECTED_POLICIES[category]:
                violations.append(
                    f"Category {category} requires TestWorld in {EXPECTED_POLICIES[category]}, "
                    f"got '{testworld}' for {test_id}"
                )
    
    print(f"[1] TAGGED TESTS   : {tagged_count}")
    print(f"[2] UNTAGGED TESTS : {untagged_count}")
    print(f"[3] VIOLATIONS     : {len(violations)}")
    
    if violations:
        print("\nViolations:")
        for v in violations[:20]:
            print(f"  - {v}")
        return 1
    
    print("\nSTATUS: PASS - All tests have valid metadata")
    return 0

def main():
    repo_root = Path(__file__).resolve().parent.parent
    
    if "--phase1" in sys.argv:
        sys.exit(audit_phase1(repo_root))
    
    if "--phase2-strict" in sys.argv:
        sys.exit(audit_phase2_strict(repo_root))
    
    if "--phase2" in sys.argv:
        sys.exit(audit_phase2(repo_root))
    
    print("Usage:")
    print("  python3 scripts/check_verification_map.py --phase1")
    print("  python3 scripts/check_verification_map.py --phase2")
    print("  python3 scripts/check_verification_map.py --phase2-strict")
    sys.exit(2)

if __name__ == "__main__":
    main()
